{
    "name": "kogomar/subscriber-api",
    "description": "GitHub Repository Release Subscriber API",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "phpmailer/phpmailer": "^6.9",
        "promphp/prometheus_client_php": "^2.6",
        "predis/predis": "^2.1",
        "ext-pdo": "*",
        "symfony/validator": "^6.4 || ^7.0",
        "zircote/swagger-php": "^4.8",
        "guzzlehttp/guzzle": "^7.8",
        "php-di/php-di": "^7.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.7",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit tests",
        "phpcs": "phpcs src tests",
        "phpstan": "phpstan analyze src tests"
    }
}
